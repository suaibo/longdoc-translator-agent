# Backend
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
WORKER_ENABLED=False
WORKER_MAX_CONCURRENCY=5
USER_MAX_CONCURRENT_JOBS=5
DATABASE_URL=postgresql+psycopg://longdoc:longdoc@127.0.0.1:5432/longdoc_translator
DATABASE_CONNECT_TIMEOUT=5
STORAGE_ROOT=./storage
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGN_SECONDS=900
FILE_RETENTION_DAYS=30
MAX_UPLOAD_BYTES=52428800
UPLOAD_READ_SIZE=1048576
CHUNK_MAX_TOKENS=1800
CHUNK_TARGET_TOKENS=1200
CHUNK_SOFT_MAX_TOKENS=1800
CHUNK_HARD_MAX_TOKENS=2400
CHUNK_MIN_TOKENS=120
SEMANTIC_BOUNDARY_THRESHOLD=0.58
BOUNDARY_LLM_MAX_RETRIES=2
TABLE_MAX_ROWS=20

# DeepSeek OpenAI-compatible API
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_MODEL_OPTIONS_JSON=
LLM_TERM_MODEL=
LLM_TRANSLATION_MODEL=
LLM_SUMMARY_MODEL=
LLM_QUALITY_MODEL=
LLM_BOUNDARY_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_SECONDS=1
LLM_MAX_OUTPUT_TOKENS=8192
JOB_MAX_TOKEN_BUDGET=2000000
JOB_MAX_COST_USD=0
# 按当前供应商价格自行配置；0 表示只统计、不启用费用上限。
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
# 可选的单一备用供应商；仅在主供应商可重试错误耗尽后切换。
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
MAX_REVISION_ATTEMPTS=1
OTEL_SERVICE_NAME=longdoc-translator-agent
OTEL_EXPORTER_OTLP_ENDPOINT=
REPLAY_INCLUDE_TEXT=False
WORKFLOW_VERSION=1
PROMPT_VERSION=1
WORKFLOW_NODE_TIMEOUT_SECONDS=1800
STREAM_TOKEN_SECRET=
STREAM_TOKEN_TTL_SECONDS=600

# Parser
OCR_ENGINE=rapidocr-onnxruntime
DEFAULT_OCR_MODE=auto
# 可选；未配置时自动发现 ~/.cache/docling/models。
# DOCLING_ARTIFACTS_PATH=C:/Users/your-name/.cache/docling/models
DOCLING_PAGE_BATCH_SIZE=1
PARSER_MAX_CONCURRENCY=1

# Gradio
GRADIO_ANALYTICS_ENABLED=False
AUTH_SESSION_DAYS=30
