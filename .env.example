# Backend
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
WORKER_ENABLED=False
DATABASE_URL=postgresql+psycopg://longdoc:longdoc@127.0.0.1:5432/longdoc_translator
DATABASE_CONNECT_TIMEOUT=5
STORAGE_ROOT=./storage
MAX_UPLOAD_BYTES=52428800
UPLOAD_READ_SIZE=1048576
CHUNK_MAX_TOKENS=1800
CHUNK_TARGET_TOKENS=1200
CHUNK_SOFT_MAX_TOKENS=1800
CHUNK_HARD_MAX_TOKENS=2400
CHUNK_MIN_TOKENS=120
SEMANTIC_BOUNDARY_THRESHOLD=0.58
TABLE_MAX_ROWS=20

# DeepSeek OpenAI-compatible API
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_TERM_MODEL=
LLM_TRANSLATION_MODEL=
LLM_SUMMARY_MODEL=
LLM_QUALITY_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_SECONDS=1
LLM_MAX_OUTPUT_TOKENS=8192
JOB_MAX_TOKEN_BUDGET=2000000
JOB_MAX_COST_USD=0
# 按当前供应商价格自行配置；0 表示只统计、不启用费用上限。
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
# 可选的单一备用供应商；仅在主供应商可重试错误耗尽后切换。
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
MAX_REVISION_ATTEMPTS=1
OTEL_SERVICE_NAME=longdoc-translator-agent
OTEL_EXPORTER_OTLP_ENDPOINT=
REPLAY_INCLUDE_TEXT=False
WORKFLOW_VERSION=1
PROMPT_VERSION=1
WORKFLOW_NODE_TIMEOUT_SECONDS=1800

# Parser
OCR_ENGINE=rapidocr-onnxruntime
DEFAULT_OCR_MODE=auto

# Gradio
GRADIO_ANALYTICS_ENABLED=False
